	@if not exist B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests mkdir B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests & if not exist B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests\$(TARGET)
	-$(DEL_DIR) B:$(INSTALL_ROOT:@msyshack@%=%)\program\Qt\6.8.2\mingw_64\tests\LagrangeTests 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

